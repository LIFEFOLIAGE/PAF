{
  "name": "foliage-fe",
  "version": "0.0.0",
  "license":"Apache-2.0",
  "publisher": "Almaviva SPA",
  "repository": {
    "url": "https://github.com/LIFEFOLIAGE/PAF"
  },
  "scripts": {
    "ng": "ng",
    "exe_umbria": "ng serve --configuration umbria-dev --proxy-config proxy.conf.js --serve-path=/foliage/umbria/",
    "exe_lazio": "ng serve --configuration lazio-dev --proxy-config proxy.conf.js --serve-path=/foliage/lazio/",
    "exe_umbria_mock": "ng serve --configuration umbria-dev-mock --proxy-config proxy.conf.js --serve-path=/foliage/umbria/",
    "exe_lazio_mock": "ng serve --configuration lazio-dev-mock --proxy-config proxy.conf.js --serve-path=/foliage/lazio/",

    "build_umbria_dev": "ng build --configuration umbria-dev --output-path dist/foliageUmbriaDev --delete-output-path",
    "build_lazio_dev": "ng build --configuration lazio-dev --output-path dist/foliageLazioDev --delete-output-path",
    "build_umbria_dev_mock": "ng build --configuration umbria-dev-mock --output-path dist/foliageUmbriaDevMock --delete-output-path",
    "build_lazio_dev_mock": "ng build --configuration lazio-dev-mock --output-path dist/foliageLazioDevMock --delete-output-path",

    "build_umbria_prod": "ng build --configuration umbria --output-path dist/foliageUmbriaProd --delete-output-path",
    "build_lazio_prod": "ng build --configuration lazio --output-path dist/foliageLazioProd --delete-output-path",

    "watch_umbria": "ng build --watch --configuration umbria-dev-mock",
    "watch_lazio": "ng build --watch --configuration lazio-dev-mock",
    "test": "ng test"
  },
  "browser": {
    "assert": false
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.2.4",
    "@angular/common": "^17.2.4",
    "@angular/compiler": "^17.2.4",
    "@angular/core": "^17.2.4",
    "@angular/forms": "^17.2.4",
    "@angular/platform-browser": "^17.2.4",
    "@angular/platform-browser-dynamic": "^17.2.4",
    "@angular/router": "^17.2.4",
    "@js-joda/core": "^5.5.3",
    "@js-joda/locale": "^4.11.0",
    "@js-joda/locale_it": "^4.11.0",
    "@js-joda/timezone": "^2.21.0",
    "angular-oauth2-oidc": "^17.0.1",
    "angular-split": "^15.0.0",
    "foliage-fe": "file:",
    "formiojs": "^4.14.15",
    "jspdf": "^2.5.1",
    "jsts": "^2.9.3",
    "ol": "^8.2.0",
    "ol-ext": "^4.0.11",
    "proj4": "^2.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.2.3",
    "@angular/cli": "~17.2.3",
    "@angular/compiler-cli": "^17.2.4",
    "@types/geojson": "^7946.0.10",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^20.2.5",
    "@types/openlayers": "^4.6.20",
    "@types/proj4": "^2.5.2",
    "jasmine-core": "~5.1.2",
    "karma": "~6.4.3",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.3.3",
    "winston": "^3.17.0"
  }
}
